#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
OVERWRITE=false
VERSION=""

# Parse arguments
for arg in "$@"; do
  case "$arg" in
    --overwrite) OVERWRITE=true ;;
    *) VERSION="$arg" ;;
  esac
done

if [[ -z "$VERSION" ]]; then
  echo "Usage: $0 <version> [--overwrite]"
  exit 1
fi

# Check if a versioned tag already exists on the remote registry.
# Returns 0 (true) if it exists, 1 (false) if not.
image_exists() {
  local image="$1"
  local tag="$2"
  docker manifest inspect "${image}:${tag}" > /dev/null 2>&1
}

manifest_matches() {
  local image="$1"
  local left_tag="$2"
  local right_tag="$3"

  diff <(docker manifest inspect "${image}:${left_tag}") <(docker manifest inspect "${image}:${right_tag}") > /dev/null 2>&1
}

build_and_push() {
  local build_dir="$1"
  local image="$2"

  if [[ "$OVERWRITE" == false ]] && image_exists "$image" "$VERSION"; then
    if image_exists "$image" latest && manifest_matches "$image" latest "$VERSION"; then
      echo "SKIP: ${image}:${VERSION} already exists and latest matches (use --overwrite to force)"
      return 0
    fi

    echo "REFRESH: ${image}:latest differs from ${image}:${VERSION}; republishing latest from the version tag"
    docker pull "${image}:${VERSION}" \
      && docker tag "${image}:${VERSION}" "${image}:latest" \
      && docker image push "${image}:latest"
    return 0
  fi

  echo "BUILD: ${image}:${VERSION}"
  cd "${SCRIPT_DIR}/containers/${build_dir}"
  tools/package_peon_module "$VERSION" \
    && docker image push "${image}:${VERSION}" \
    && docker image push "${image}:latest"
}

echo "Getting latest steamcmd containers from cm2network/steamcmd"
docker pull cm2network/steamcmd:latest
build_and_push "steamcmd-wine"   "umlatt/steamcmd-winehq"
build_and_push "steamcmd-proton" "umlatt/steamcmd-proton"
build_and_push "steamcmd"        "umlatt/steamcmd"